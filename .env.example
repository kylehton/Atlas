# Runtime
ATLAS_ENVIRONMENT=development
ATLAS_LOG_LEVEL=INFO
ATLAS_DATABASE_URL=postgresql+psycopg://atlas:atlas@localhost:5432/atlas
ATLAS_MODEL_BASE_URL=http://localhost:8081

# Local Docker Compose
ATLAS_POSTGRES_PASSWORD=atlas
ATLAS_HTTP_PORT=8080
ATLAS_MODEL_FILE=model.gguf
ATLAS_MODEL_CONTEXT_SIZE=4096
ATLAS_LLAMA_CPP_IMAGE=ghcr.io/ggml-org/llama.cpp:server-b10524

# Integration secrets are optional until their features are enabled.
ATLAS_TELEGRAM_BOT_TOKEN=
ATLAS_TELEGRAM_WEBHOOK_SECRET=
ATLAS_GOOGLE_CLIENT_ID=
ATLAS_GOOGLE_CLIENT_SECRET=

# Production-only examples
# ATLAS_ENVIRONMENT=production
# ATLAS_DATABASE_URL=postgresql+psycopg://<user>:<password>@<supabase-host>:5432/<database>
# ATLAS_SITE_ADDRESS=atlas.example.com

